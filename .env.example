# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cats
PGUSER=cat_shelter
PGPASSWORD=replace_me

# Optional: directory containing pg_dump and pg_restore if they are not in PATH.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# Used to sign anonymous visitor cookies (32+ random characters).
COOKIE_SECRET=replace_with_a_long_random_secret

# Required only when the admin_users table is empty.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
PORT=3000


# HTTPS and network binding
HTTPS_ENABLED=true
HOST=0.0.0.0
TLS_KEY_PATH=certs/server.key
TLS_CERT_PATH=certs/server.crt
COOKIE_SECURE=true
