# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cats
PGUSER=cat_shelter
PGPASSWORD=replace_me

# Optional: directory containing pg_dump and pg_restore if they are not in PATH.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# Used to sign anonymous visitor cookies (32+ random characters).
COOKIE_SECRET=replace_with_a_long_random_secret

# Required only when the admin_users table is empty.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# Public URL used in registration, password reset, moderation, and account links.
PUBLIC_ORIGIN=https://kind4cat.ru

# Optional transactional email webhook. The server POSTs JSON with {to, subject, text}.
# Without it, development builds print email previews to the server log.
# EMAIL_DELIVERY_WEBHOOK=https://mailer.example/api/send
# EMAIL_DELIVERY_TOKEN=replace_me

# Or send directly over SMTP (for Gmail use smtp.gmail.com, port 465, secure=true,
# and a Google app password rather than the account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=sender@gmail.com
# SMTP_PASSWORD=replace_with_app_password
# EMAIL_FROM="Доброта для кота <sender@gmail.com>"

# Optional cookie names for running an isolated preview on the same host.
# SESSION_COOKIE_NAME=shelter_preview_session
# VISITOR_COOKIE_NAME=shelter_preview_visitor

# Disable the scheduled backup worker for preview processes.
# DISABLE_AUTOMATIC_BACKUPS=true

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
PORT=3000


# HTTPS and network binding
HTTPS_ENABLED=true
HOST=0.0.0.0
TLS_KEY_PATH=certs/server.key
TLS_CERT_PATH=certs/server.crt
COOKIE_SECURE=true
